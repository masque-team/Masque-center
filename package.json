{
  "name": "masquegame-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/masque-center",
    "apps/masque-vease",
    "packages/vease-protocol"
  ],
  "scripts": {
    "test": "npm run test --workspace=masque-center",
    "test:ux": "node scripts/verify-ux-redesign.mjs",
    "dev": "npm run dev --workspace=masque-center",
    "dev:mv": "npm run dev --workspace=masque-vease",
    "test:mv": "npm run test --workspace=masque-vease",
    "check:mv": "npm run check --workspace=masque-vease",
    "build:mv": "npm run build --workspace=masque-vease",
    "build": "npm run build --workspace=masque-center",
    "check": "npm run check --workspace=masque-center",
    "art": "node scripts/optimize-art.mjs",
    "art:world": "node scripts/generate-world-art.mjs",
    "art:cosmetics": "node scripts/generate-cosmetics.mjs",
    "art:points": "node scripts/generate-point-art.mjs",
    "preview": "npm run preview --workspace=masque-center"
  },
  "dependencies": {
    "@lucide/svelte": "^1.57.0",
    "@masque/vease-protocol": "file:packages/vease-protocol",
    "svelte": "^5.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "@types/three": "^0.186.0",
    "sharp": "^0.35.5",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
