{
  "name": "masquegame-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/masque-vease",
    "packages/vease-protocol"
  ],
  "scripts": {
    "test": "vitest run --exclude apps/**",
    "dev": "vite --host 0.0.0.0",
    "dev:mv": "npm run dev --workspace=masque-vease",
    "test:mv": "npm run test --workspace=masque-vease",
    "check:mv": "npm run check --workspace=masque-vease",
    "build:mv": "npm run build --workspace=masque-vease",
    "build": "svelte-check && vite build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "art": "node scripts/optimize-art.mjs",
    "art:world": "node scripts/generate-world-art.mjs",
    "art:cosmetics": "node scripts/generate-cosmetics.mjs",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.57.0",
    "@masque/vease-protocol": "file:packages/vease-protocol",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@tsconfig/svelte": "^5.0.8",
    "sharp": "^0.35.5",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.0.0",
    "typescript": "~5.7.2",
    "vite": "^6.0.0",
    "vitest": "^5.0.5"
  }
}
